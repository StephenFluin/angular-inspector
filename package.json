{
    "name": "angular-inspector",
    "version": "1.23.0",
    "private": true,
    "description": "Chrome extension that detects Angular and the JavaScript frameworks, libraries and backend tools used by the sites you visit.",
    "license": "MIT",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "https://github.com/stephenfluin/angular-inspector/"
    },
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "build": "node scripts/build.mjs",
        "watch": "node scripts/build.mjs --watch",
        "typecheck": "tsc --noEmit",
        "test": "node --test \"test/*.test.ts\"",
        "check-icons": "node scripts/check-icons.mjs",
        "icons": "node scripts/generate-icons.mjs",
        "package": "npm run typecheck && npm test && npm run check-icons && npm run build && rm -f ai.zip && cd src && zip -qr ../ai.zip . -x '*.ts' -x 'dist/*.map'",
        "format": "prettier --write \"src/**/*.{ts,html,css,json}\" \"scripts/*.mjs\" \"test/*.ts\"",
        "version": "node scripts/sync-version.mjs && git add src/manifest.json"
    },
    "devDependencies": {
        "@types/chrome": "^0.3.0",
        "@types/node": "^26.6.3",
        "esbuild": "^0.28.2",
        "prettier": "^3.9.9",
        "simple-icons": "^16.33.0",
        "typescript": "^7.0.2"
    }
}
