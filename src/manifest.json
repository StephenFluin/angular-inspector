{
    "manifest_version": 3,
    "name": "Angular Inspector",
    "version": "1.23.0",
    "description": "Detect Angular and the JavaScript frameworks, libraries, analytics and backend tools used by the sites you visit.",
    "minimum_chrome_version": "111",
    "icons": {
        "32": "icon32.png",
        "48": "icon48.png",
        "64": "icon64.png",
        "128": "icon128.png"
    },
    "background": {
        "service_worker": "dist/service_worker.js",
        "type": "module"
    },
    "content_scripts": [
        {
            "js": ["dist/bridge.js"],
            "matches": ["http://*/*", "https://*/*"],
            "run_at": "document_start"
        },
        {
            "js": ["dist/detector.js"],
            "matches": ["http://*/*", "https://*/*"],
            "run_at": "document_idle",
            "world": "MAIN"
        }
    ],
    "action": {
        "default_icon": {
            "16": "icon.png",
            "32": "icon32.png"
        },
        "default_popup": "popup.html",
        "default_title": "Angular Inspector"
    },
    "options_ui": {
        "page": "options.html",
        "open_in_tab": true
    },
    "permissions": ["webRequest", "storage"],
    "host_permissions": ["http://*/*", "https://*/*"]
}
